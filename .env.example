# ═══════════════════════════════════════════════════════════════════════════════
# RedBoost — Variables d'environnement
# COPIER ce fichier vers .env.production et remplir les valeurs réelles
# NE JAMAIS committer .env.production dans Git
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database MySQL ────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_USER=redboost_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_256BIT_HEX_KEY

# ─── Google AI / Groq ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ─── Google OAuth2 / Calendar ─────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_refresh_token
GOOGLE_OAUTH_ORGANIZER_EMAIL=your_organizer@gmail.com

# ─── Cloudinary (stockage fichiers) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Email SMTP ───────────────────────────────────────────────────────────────
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ─── Frontend URL ─────────────────────────────────────────────────────────────
API_URL=https://redboost.tn

# ─── Docker / CI-CD ───────────────────────────────────────────────────────────
# Set automatically by GitHub Actions. For local docker compose:
# REGISTRY=ghcr.io/your-github-username/your-repo-name
REGISTRY=ghcr.io/your-github-username/your-repo-name

# ─── Firebase (for docker-compose volume mount) ────────────────────────────────
# In CI/CD: store the full JSON content in GitHub Secret FIREBASE_SERVICE_ACCOUNT_JSON
# Locally: copy firebase-service-account.json to the project root (next to docker-compose.yml)
# cp redboost_backend/src/main/resources/firebase-service-account.json ./firebase-service-account.json
